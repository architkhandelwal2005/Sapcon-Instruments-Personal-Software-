# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                 # postgres connection string, for running migrations directly

# Extraction provider: "gemini" (free tier, dev default) or "anthropic" (paid, production default)
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GEMINI_MODEL=                  # optional override, defaults to gemini-2.5-flash
ANTHROPIC_API_KEY=              # only needed when EXTRACTION_PROVIDER=anthropic
